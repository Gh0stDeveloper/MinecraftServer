[Unit]
Description=Bedrock Network public status website
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=bedrock
Group=bedrock
WorkingDirectory=/opt/bedrock-network/app/web
EnvironmentFile=-/opt/bedrock-network/config/network.env
Environment=BEDROCK_BASE=/opt/bedrock-network
Environment=WEB_HOST=0.0.0.0
ExecStart=/usr/bin/python3 /opt/bedrock-network/app/web/server.py
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/bedrock-network/state /opt/bedrock-network/uploads

[Install]
WantedBy=multi-user.target
