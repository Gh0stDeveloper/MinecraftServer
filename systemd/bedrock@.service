[Unit]
Description=Minecraft Bedrock Network instance (%i)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=bedrock
Group=bedrock
WorkingDirectory=/opt/bedrock-network/instances/%i
ExecStart=/opt/bedrock-network/app/scripts/launch-instance.sh %i
Restart=on-failure
RestartSec=5
KillSignal=SIGINT
TimeoutStopSec=60
LimitNOFILE=1048576
Nice=-2

[Install]
WantedBy=multi-user.target
