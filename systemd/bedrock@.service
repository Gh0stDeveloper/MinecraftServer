[Unit]
Description=Minecraft Bedrock Dedicated Server (%i)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=bedrock
Group=bedrock
WorkingDirectory=/opt/bedrock-network/instances/%i
Environment=LD_LIBRARY_PATH=/opt/bedrock-network/instances/%i
ExecStart=/opt/bedrock-network/instances/%i/bedrock_server
Restart=on-failure
RestartSec=5
KillSignal=SIGINT
TimeoutStopSec=45
LimitNOFILE=65535
Nice=-2

[Install]
WantedBy=multi-user.target
