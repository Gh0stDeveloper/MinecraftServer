# Motor por instancia. Valores soportados: bds, pnx
# Lobby y Survival permanecen siempre en BDS por diseño.
LOBBY_ENGINE=bds
SURVIVAL_ENGINE=bds
PVP_ENGINE=pnx
BEDWARS_ENGINE=pnx
SKYWARS_ENGINE=pnx

# PowerNukkitX. Primero se intenta el snapshot oficial publicado por upstream.
# Si el asset desaparece/da 404, el updater construye el shaded JAR desde el
# commit oficial fijado aquí, validado para la misma versión Bedrock.
PNX_DOWNLOAD_URL="https://github.com/PowerNukkitX/PowerNukkitX/releases/download/snapshot/powernukkitx-shaded.jar"
PNX_SOURCE_REPO="https://github.com/PowerNukkitX/PowerNukkitX.git"
PNX_SOURCE_REF="e9d4ffaa5638ca0f82bcdedf3320afd6cf92e38d"
PNX_EXPECTED_VERSION="3.0.2"
PNX_EXPECTED_MINECRAFT="26.40"
PNX_JAVA_MIN=21
PNX_HEAP_MIN="512M"
PNX_HEAP_MAX="2G"

# Plugins administrados por el catálogo del proyecto.
# Solo se actualizan cuando cambia la referencia fijada en config/plugins.json.
MANAGED_PLUGINS=true
