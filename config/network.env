# Nombre visible en la web y herramientas de administración.
SERVER_NAME="Bedrock Network"

# Despliegue principal de la red.
# PUBLIC_IP siempre queda disponible como fallback si el dominio todavía no resuelve.
PUBLIC_IP=147.224.196.17
PUBLIC_DOMAIN=minecraftserver.duckdns.org

# Host que reciben los clientes mediante /transfer. El instalador puede promover
# PUBLIC_DOMAIN automáticamente cuando resuelva a PUBLIC_IP; mientras tanto usa IP.
PUBLIC_HOST=147.224.196.17

LOBBY_PORT=19132
SURVIVAL_PORT=19133
PVP_PORT=19134
BEDWARS_PORT=19135
SKYWARS_PORT=19136
WEB_PORT=8080

BASE_DIR=/opt/bedrock-network
BACKUP_DIR=/opt/bedrock-network/backups
MAX_PLAYERS=20
