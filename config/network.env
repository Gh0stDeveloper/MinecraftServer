# Nombre visible en la web y herramientas de administración.
SERVER_NAME="Bedrock Network"

# Dirección pública que usarán los clientes al recibir /transfer.
# Puede ser una IP o un dominio, sin protocolo.
PUBLIC_HOST=127.0.0.1

LOBBY_PORT=19132
SURVIVAL_PORT=19133
PVP_PORT=19134
BEDWARS_PORT=19135
SKYWARS_PORT=19136
WEB_PORT=8080

BASE_DIR=/opt/bedrock-network
BACKUP_DIR=/opt/bedrock-network/backups
MAX_PLAYERS=20
