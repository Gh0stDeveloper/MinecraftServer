# Identidad visible en la web, herramientas y anuncios Bedrock.
SERVER_NAME="Nexora Network"
SERVER_DESCRIPTION="Survival, PvP, BedWars y SkyWars en una sola aventura"

# Estos valores se completan durante la primera instalación.
# No pongas datos privados ni una IP/dominio del autor en el template público.
PUBLIC_IP=""
PUBLIC_DOMAIN=""

# Host que reciben los clientes mediante /transfer.
# Si el dominio todavía no resuelve a PUBLIC_IP, el instalador usa la IP como
# fallback y permite promover el dominio después con: mcserver network use-domain
PUBLIC_HOST=""

# Las transferencias del Lobby usan la IPv4 por defecto para no depender del
# DNS del dispositivo. `mcserver network use-domain` cambia este modo a domain.
TRANSFER_HOST_MODE="ip"

LOBBY_PORT=19132
SURVIVAL_PORT=19133
PVP_PORT=19134
BEDWARS_PORT=19135
SKYWARS_PORT=19136

# Lobby y Survival usan BDS en puertos internos. El gateway RakNet publica los
# puertos anteriores con un anuncio MCPE completo y reenvía el juego al backend.
LOBBY_BACKEND_PORT=20132
SURVIVAL_BACKEND_PORT=20133
LOBBY_BACKEND_PORTV6=20152
SURVIVAL_BACKEND_PORTV6=20153
GATEWAY_SESSION_TTL=120
GATEWAY_MAX_SESSIONS=2048

# Normalmente el gateway aprende protocolo/versión desde un minijuego PNX sano.
# Solo fija estos valores si ejecutas Lobby/Survival sin ninguna instancia PNX.
BEDROCK_PROTOCOL=""
BEDROCK_VERSION=""
WEB_PORT=8080
WEB_MAX_UPLOAD_MB=4096

BASE_DIR=/opt/bedrock-network
BACKUP_DIR=/opt/bedrock-network/backups
MAX_PLAYERS=20
